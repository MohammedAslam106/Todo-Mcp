PORT=3000
NODE_ENV=development

# PostgreSQL connection string for the dedicated app user (see README.md)
DATABASE_URL=postgresql://todo_app_user:CHANGE_ME@localhost:5432/todo_app

# Random secret used to sign JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

# Public address of the app, as typed in the browser. OAuth providers redirect back to
# <APP_URL>/api/auth/<google|github>/callback, so register exactly that URL with them.
APP_URL=http://localhost:3000

# Sign in with Google: https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

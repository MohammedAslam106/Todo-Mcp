{
  "name": "todo-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch server.ts --dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && cross-env NODE_ENV=production vite build && pnpm build:server",
    "start": "cross-env NODE_ENV=production node --enable-source-maps build/server.js",
    "migrate": "tsx db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "mcp:token": "tsx scripts/create-mcp-token.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=build/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/react": "^1.2.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/vite": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@unhead/react": "^2.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "history": "^5.3.0",
    "lucide-react": "^1.46.0",
    "minipass": "^7.1.2",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.3",
    "react-router": "^7.18.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "valtio": "^2.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.23",
    "postcss-preset-env": "^11.5.1",
    "tailwindcss": "^4.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "vite@8.3.0": "patches/vite@8.3.0.patch"
    }
  }
}
